# Input for the convergence tests and pure-element runs (T > 0 only).
# Potential: potential/potential.lmp. Same protocol as in.surface.lmp (normally called by src/run.py). Averages are running averages, and the full time
# series (neq + nprod steps) of the box lengths (NPT) and potential energy (both NVT runs) is written to file.
variable T      index 700
variable data   index cell.data
variable tag    index run
variable vac    index 20.0
variable seed   index 12345
variable neq    index 5000
variable nprod  index 20000
variable etol   index 1e-10

units       metal
boundary    p p p
atom_style  atomic
read_data   ${data}

include     potential/potential.lmp
neighbor    2.0 bin
timestep    0.002
thermo      2000
thermo_style custom step temp pe press lx ly lz

variable bx equal lx
variable by equal ly
variable bz equal lz
variable N  equal atoms

# 1. relax atoms + box at 0 K
fix relax all box/relax aniso 0.0
minimize ${etol} ${etol} 10000 100000
unfix relax
minimize ${etol} ${etol} 10000 100000

# 2. NPT bulk at T, zero pressure -> mean box   (trbox = full box-length series)
velocity all create ${T} ${seed} mom yes rot yes dist gaussian
fix npt all npt temp ${T} ${T} 0.2 aniso 0.0 0.0 2.0
fix trbox all ave/time 10 1 10 v_bx v_by v_bz file ${tag}_npt_box.dat
run ${neq}
fix boxavg all ave/time 10 1 10 v_bx v_by v_bz ave running
run ${nprod}
variable Lx equal $(f_boxavg[1])
variable Ly equal $(f_boxavg[2])
variable Lz equal $(f_boxavg[3])
unfix boxavg
unfix trbox
unfix npt

# 3. NVT bulk in the mean box -> <PE_bulk>   (trbulk = full PE series)
change_box all x final 0 ${Lx} y final 0 ${Ly} z final 0 ${Lz} remap
velocity all create ${T} ${seed} mom yes rot yes dist gaussian
fix nvt all nvt temp ${T} ${T} 0.2
fix trbulk all ave/time 10 1 10 c_thermo_pe file ${tag}_bulk_full.dat
run ${neq}
fix peser all ave/time 10 1 10 c_thermo_pe file ${tag}_bulk_pe.dat
fix peavg all ave/time 10 1 10 c_thermo_pe ave running
run ${nprod}
variable Ebulk equal $(f_peavg)
unfix trbulk
unfix peser
unfix peavg
unfix nvt

# 4+5. add vacuum along z (same atoms) -> NVT slab -> <PE_slab>
change_box all z final 0 $(v_Lz+v_vac) units box
velocity all create ${T} ${seed} mom yes rot yes dist gaussian
fix nvt all nvt temp ${T} ${T} 0.2
fix trslab all ave/time 10 1 10 c_thermo_pe file ${tag}_slab_full.dat
run ${neq}
fix peser all ave/time 10 1 10 c_thermo_pe file ${tag}_slab_pe.dat
fix peavg all ave/time 10 1 10 c_thermo_pe ave running
run ${nprod}
variable Eslab equal $(f_peavg)
unfix trslab

variable gamma equal (v_Eslab-v_Ebulk)/(2*v_Lx*v_Ly)*16021.766
print "${T} ${N} ${Lx} ${Ly} ${Lz} ${Ebulk} ${Eslab} ${gamma}" file ${tag}_result.txt
print "gamma = ${gamma} mJ/m^2"
